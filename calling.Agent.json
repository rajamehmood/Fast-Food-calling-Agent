        "mode": "runOnceForEachItem",
        "jsCode": "const body = $json.body || {};\nconst calls = (body.message && body.message.toolCalls) || [];\nconst fn = (calls[0] && calls[0].function) || {};\nlet args = fn['argu' + 'ments'] || {};\nif (typeof args === 'string') { try { args = JSON.parse(args); } catch (e) { args = {}; } }\nconst now = new Date(Date.now() + 5 * 3600 * 1000);\nconst pad = (n) => String(n).padStart(2, '0');\nconst stamp = now.getUTCFullYear() + pad(now.getUTCMonth() + 1) + pad(now.getUTCDate()) + '-' + pad(now.getUTCHours()) + pad(now.getUTCMinutes()) + pad(now.getUTCSeconds());\nconst callId = (body.message && body.message.call && body.message.call.id) || '';\nreturn { json: {\n  customer_name: args.customer_name || args.name || '',\n  phone_number: args.phone_number || args.phone || '',\n  delivery_address: args.delivery_address || args.address || '',\n  item_ordered: args.item_ordered || args.item || args.items || '',\n  quantity: args.quantity ?? '',\n  unit_price: args.unit_price ?? '',\n  total_amount: args.total_amount ?? args.total ?? '',\n  order_id: args.order_id || ('ORD-' + stamp + (callId ? '-' + callId.slice(-4) : '')),\n  order_status: args.order_status || 'confirmed'\n} };"
      },
